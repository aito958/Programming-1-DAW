	/**
	 * Genera el mundo cumpliendo: Suelo (z=0, z=1) sin bloques vacíos. Resto del
	 * mundo con alta probabilidad de bloques vacíos para asegurar > 50% en total.
	 */
	public static Bloque[][][] generarMundo() {
		Bloque[][][] mundo = new Bloque[TAMANO_MUNDO][TAMANO_MUNDO][TAMANO_MUNDO];
		Random rd = new Random();

		for (int z = 0; z < TAMANO_MUNDO; z++) {
			for (int x = 0; x < TAMANO_MUNDO; x++) {
				for (int y = 0; y < TAMANO_MUNDO; y++) {
					if (z < 2) {
						// Suelo: Nunca vacío (forzamos un tipo de materia válido, del 0 al 5)
						int tipo = rd.nextInt(Bloque.NUM_MATERIAS);
						mundo[x][y][z] = instanciarBloque(tipo, x, y, z);
					} else {
						// Para asegurar que al menos la mitad (500) sean vacíos, damos un 65% de
						// probabilidad de ser vacío a las capas superiores (z de 2 a 9).
						if (rd.nextDouble() < 0.65) {
							mundo[x][y][z] = new BloqueVacio(x, y, z);
						} else {
							int tipo = rd.nextInt(Bloque.NUM_MATERIAS);
							mundo[x][y][z] = instanciarBloque(tipo, x, y, z);
						}
					}
				}
			}
		}
		return mundo;
	}

	private static Bloque instanciarBloque(int tipo, int x, int y, int z) {
		switch (tipo) {
		case Bloque.ALBERO:
			return new BloqueAlbero(x, y, z);
		case Bloque.ARBOL:
			return new BloqueArbol(x, y, z);
		case Bloque.ARCILLA:
			return new BloqueArcilla(x, y, z);
		case Bloque.COBRE:
			return new BloqueCobre(x, y, z);
		case Bloque.HIERRO:
			return new BloqueHierro(x, y, z);
		case Bloque.PLANTA:
			return new BloquePlanta(x, y, z);
		default:
			return new BloqueVacio(x, y, z);
		}
	}

	/**
	 * Coloca al jugador en la primera posición vacía (menor x, y, z posible).
	 */
	public static void colocarJugadorInicial(Jugador jugador, Bloque[][][] mundo) {
		for (int z = 0; z < TAMANO_MUNDO; z++) {
			for (int y = 0; y < TAMANO_MUNDO; y++) {
				for (int x = 0; x < TAMANO_MUNDO; x++) {
					if (mundo[x][y][z] instanceof BloqueVacio) {
						jugador.setPosicion(x, y, z);
						System.out.println("Jugador " + jugador.nombre + " posicionado inicialmente en: (X:" + x
								+ ", Y:" + y + ", Z:" + z + ")");
						return; // Terminamos en cuanto encontramos el primero
					}
				}
			}
		}
	}

	/**
	 * Gestiona el movimiento y la destrucción de bloques con desgaste de herramientas.
	 */
	public static void gestionarMovimiento(Jugador j, Bloque[][][] mundo, Scanner sc) {
		System.out.println("¿Hacia donde te quieres mover? (W: Arriba[+z], S: Abajo[-z], A: Izq[-x], D: Der[+x], Q: Adelante[+y], E: Atrás[-y])");
		String teclaPulsada = sc.nextLine().toUpperCase();

		int nextX = j.x, nextY = j.y, nextZ = j.z;

		switch (teclaPulsada.toLowerCase()) { // Pasamos a minúsculas por si acaso
		    case "d":
		        nextX = nextX + 1;
		        break;
		    case "a":
		        nextX = nextX - 1;
		        break;
		    case "q":
		        nextY = nextY + 1;
		        break;
		    case "e":
		        nextY = nextY - 1;
		        break;
		    case "w":
		        nextZ = nextZ + 1;
		        break;
		    case "s":
		        nextZ = nextZ - 1;
		        break;
		    default:
		        // Si el usuario mete cualquier otra cosa
		        System.out.println("Error: Dirección " + teclaPulsada + " no reconocida.");
		        return; // Cortamos la ejecución del movimiento aquí
		}

		// Control de límites manual (chapuza total)
		if (nextX >= TAMANO_MUNDO) {
		    nextX = 0;
		}
		if (nextX < 0) {
		    nextX = TAMANO_MUNDO - 1;
		}

		if (nextY >= TAMANO_MUNDO) {
		    nextY = 0;
		}
		if (nextY < 0) {
		    nextY = TAMANO_MUNDO - 1;
		}

		if (nextZ >= TAMANO_MUNDO) {
		    nextZ = 0;
		}
		if (nextZ < 0) {
		    nextZ = TAMANO_MUNDO - 1;
		}
		Bloque bloqueDestino = mundo[nextX][nextY][nextZ];

		if (bloqueDestino instanceof BloqueVacio) {
			j.setPosicion(nextX, nextY, nextZ);
			System.out.println("Te has movido a una casilla vacía: (" + nextX + "," + nextY + "," + nextZ + ")");
		} else {
			System.out.println("¡Hay un bloque interponiéndose! , ¿Con qué intentas destruirlo?");
			System.out.println("1. Pico | 2. Pala | 3. Hacha");
			String opcion = sc.nextLine();
			String herramientaSeleccionada = " ";

			if (opcion.equals("1")) {
			    herramientaSeleccionada = BloqueMineral.HERRAMIENTA;
			} else if (opcion.equals("2")) {
			    herramientaSeleccionada = BloqueTierra.HERRAMIENTA;
			} else if (opcion.equals("3")) {
			    herramientaSeleccionada = BloqueVegetal.HERRAMIENTA;
			} else {
			    // Si no es 1, 2 o 3, mostramos error y cortamos el movimiento
			    System.out.println("Herramienta no válida. Cancelando movimiento.");
			    return;
			}

			int usos = 0;

			// Miramos cuántos usos tiene la herramienta que ha elegido el usuario
			if (opcion.equals("1")) {
			    usos = j.usosPico;
			} else if (opcion.equals("2")) {
			    usos = j.usosPala;
			} else if (opcion.equals("3")) {
			    usos = j.usosHacha;
			}

			// Si la herramienta tiene usos (es mayor que 0)
			if (usos > 0) {
			    
			    // 1. Miramos qué herramienta es la que debería usarse para este bloque
			    String herramientaCorrecta = "";
			    if (bloqueDestino instanceof BloqueMineral) {
			        herramientaCorrecta = "1"; // El Pico
			    } else if (bloqueDestino instanceof BloqueTierra) {
			        herramientaCorrecta = "2"; // La Pala
			    } else if (bloqueDestino instanceof BloqueVegetal) {
			        herramientaCorrecta = "3"; // El Hacha
			    }

			    // 2. Gastamos el uso en la variable real del jugador
			    if (opcion.equals("1")) {
			        j.usosPico = j.usosPico - 1;
			    } else if (opcion.equals("2")) {
			        j.usosPala = j.usosPala - 1;
			    } else if (opcion.equals("3")) {
			        j.usosHacha = j.usosHacha - 1;
			    }

			    // 3. Comprobamos si la herramienta que ha elegido el usuario es la correcta
			    if (opcion.equals(herramientaCorrecta)) {
			        // Si es correcta, llamamos a destruir pasando el nombre de la herramienta que espera el bloque
			        String nombreH = "";
			        if (opcion.equals("1")) nombreH = BloqueMineral.HERRAMIENTA;
			        if (opcion.equals("2")) nombreH = BloqueTierra.HERRAMIENTA;
			        if (opcion.equals("3")) nombreH = BloqueVegetal.HERRAMIENTA;
			        
			        bloqueDestino.destruir(nombreH, j);
			        System.out.println("¡Bloque destruido y material recolectado!");
			    } else {
			        // Si no es la correcta, el bloque se rompe pero no recolectamos nada (según el enunciado)
			        System.out.println("Herramienta incorrecta. El bloque se rompe pero no obtienes nada.");
			    }

			    // 4. Movemos al jugador y vaciamos la casilla
			    mundo[nextX][nextY][nextZ] = new bloque.material.BloqueVacio(nextX, nextY, nextZ);
			    j.setPosicion(nextX, nextY, nextZ);

			} else {
			    // Si 'usos' era 0 o menos
			    System.out.println("No te quedan usos en esta herramienta. ¡Debes repararla!");
			}

		if (opcion.equals("1")) {
		    // Si eligió la 1, le restamos 1 al Pico
		    j.usosPico = j.usosPico - 1;
		} else if (opcion.equals("2")) {
		    // Si eligió la 2, le restamos 1 a la Pala
		    j.usosPala = j.usosPala - 1;
		} else if (opcion.equals("3")) {
		    // Si eligió la 3, le restamos 1 al Hacha
		    j.usosHacha = j.usosHacha - 1;
		}
		if (herramientaSeleccionada.equals(herramientaCorrecta)) {
			// Destrucción exitosa con recolecta
			bloqueDestino.destruir(herramientaSeleccionada, j);
			System.out.println("¡Bloque destruido CORRECTAMENTE! Has recolectado la materia.");
		} else {
			// Destrucción sin recolecta por usar herramienta incorrecta
			System.out.println("Herramienta incorrecta... El bloque se destruye pero NO obtienes materiales.");
		}

		// Reemplazamos el bloque por uno vacío y movemos al jugador
		mundo[nextX][nextY][nextZ] = new BloqueVacio(nextX, nextY, nextZ);
		j.setPosicion(nextX, nextY, nextZ);
		System.out.println("Te has movido a la casilla: (" + nextX + "," + nextY + "," + nextZ + ")");
		System.out.println("Tu " + herramientaSeleccionada + " tiene ahora " + (usosRestantes - 1) + " usos.");

	}else
	{
		System.out.println("¡Tu " + herramientaSeleccionada + " está rota! (0 usos). Debes repararla.");
		System.out.println("No te has podido mover.");
	}
	}
