	/**
	 * Funcionalidad inventada y documentada: Radar de Proximidad. Analiza un área
	 * de 3x3x3 alrededor del jugador para contar cuántos recursos hay cerca,
	 * ayudando al jugador a decidir hacia dónde picar. Consume 1 uso de cualquier
	 * herramienta al azar.
	 */
	public static void usarRadar(Jugador j, Bloque[][][] mundo) {
		System.out.println("\n[📡 Activando Radar de Proximidad...]");
		int bloquesUtiles = 0;

		for (int z = -1; z <= 1; z++) {
			for (int y = -1; y <= 1; y++) {
				for (int x = -1; x <= 1; x++) {
					// Comprobar límites toroidales
					int checkX = (j.x + x + TAMANO_MUNDO) % TAMANO_MUNDO;
					int checkY = (j.y + y + TAMANO_MUNDO) % TAMANO_MUNDO;
					int checkZ = (j.z + z + TAMANO_MUNDO) % TAMANO_MUNDO;

					if (!(mundo[checkX][checkY][checkZ] instanceof BloqueVacio)) {
						bloquesUtiles++;
					}
				}
			}
		}
		System.out.println(
				"El radar indica que hay " + bloquesUtiles + " bloques sólidos en tu entorno inmediato (3x3).");
	}

	/**
	 * Opción secreta: Muestra la cantidad total de bloques en el mundo por
	 * categoría.
	 */
	public static void mostrarMapaSecreto(Bloque[][][] mundo) {
		int vacios = 0, minerales = 0, tierras = 0, vegetales = 0;

		for (int z = 0; z < TAMANO_MUNDO; z++) {
			for (int y = 0; y < TAMANO_MUNDO; y++) {
				for (int x = 0; x < TAMANO_MUNDO; x++) {
					Bloque b = mundo[x][y][z];
					if (b instanceof BloqueVacio)
						vacios++;
					else if (b instanceof BloqueMineral)
						minerales++;
					else if (b instanceof BloqueTierra)
						tierras++;
					else if (b instanceof BloqueVegetal)
						vegetales++;
				}
			}
		}
		System.out.println("---  MAPA SECRETO (Estadísticas globales) ---");
		System.out.println("Bloques vacíos: " + vacios + " (" + ((vacios * 100) / 1000) + "%)");
		System.out.println("Bloques Minerales: " + minerales);
		System.out.println("Bloques de Tierra: " + tierras);
		System.out.println("Bloques Vegetales: " + vegetales);
		System.out.println("-------------------------------------------------");
	}
