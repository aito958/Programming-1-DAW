public class PiedraPapelTijeras {

    public static void main(String[] args) {

        Jugador[] jugadores = {
            new Jugador("Patricio", "fijo"),
            new Jugador("Bob", "random"),
            new Jugador("Calamardo", "ciclo")
        };

        int[] victorias = new int[3];

        System.out.println("HACIENDO PRUEBA PARA 10 PARTIDAS ");
        jugarPrueba(jugadores, victorias, 10);
        mostrarResultados(jugadores, victorias);

        System.out.println("HACIENDO PRUEBA PARA 100 PARTIDAS ");
        victorias = new int[3]; // reiniciar
        jugarPrueba(jugadores, victorias, 100);
        mostrarResultados(jugadores, victorias);
    }

    public static void jugarPrueba(Jugador[] j, int[] victorias, int n) {
        enfrentarPareja(j, victorias, 0, 1, n); // Patricio vs Bob
        enfrentarPareja(j, victorias, 0, 2, n); // Patricio vs Calamardo
        enfrentarPareja(j, victorias, 2, 1, n); // Calamardo vs Bob
    }

    public static void enfrentarPareja(Jugador[] j, int[] victorias, int a, int b, int n) {
        for (int i = 0; i < n; i++) {
            int r = Partida.enfrentar(j[a], j[b]);
            if (r == 1) victorias[a]++;
            else if (r == 2) victorias[b]++;
        }
    }

    public static void mostrarResultados(Jugador[] j, int[] victorias) {
        System.out.println("\nResultados:");

        int total = victorias[0] + victorias[1] + victorias[2];

        for (int i = 0; i < j.length; i++) {
            double porcentaje = (victorias[i] / (double) total) * 100;
            System.out.printf("%s: %d victorias (%.2f%%)\n",
                    j[i].getNombre(), victorias[i], porcentaje);
        }
    }
}
