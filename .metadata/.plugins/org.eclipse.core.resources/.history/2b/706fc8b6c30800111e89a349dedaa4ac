import java.util.Random;
import java.util.Scanner;

public class Jugador {
    public static void main(String[] args) {
        Jugador player = new Jugador();
        Scanner sc = new Scanner(System.in);
        Random rand = new Random();
        
        try {
            System.out.println("🎯 ARROW MERGE RUN - EXAMEN POO 🎯");
            System.out.println("Empiezas con 1 flecha. ¡Maximiza al final!\n");
            
            for (int nivel = 1; nivel <= 10; nivel++) {
                System.out.println("\n=== NIVEL " + nivel + " ===");
                System.out.println("Flechas actuales: " + player.getFlechas());
                
                System.out.print("Elige: 1=+1, 2=-1, 3=x" + (2+rand.nextInt(2)) + 
                                ", 4=/" + (2+rand.nextInt(2)) + " → ");
                
                int opcion = sc.nextInt();
                int valor = (opcion == 3 || opcion == 4) ? 2 + rand.nextInt(2) : 1;
                
                player.elegir(opcion, valor);
                
                if (player.gameOver()) {
                    System.out.println("💀 GAME OVER en nivel " + nivel);
                    break;
                }
            }
            
            if (!player.gameOver()) {
                System.out.println("\n🏆 ¡VICTORIA! Final: " + player.getFlechas() + " flechas");
            }
            
        } catch (Exception e) {
            System.out.println("❌ Error: " + e.getMessage());
        } finally {
            sc.close();
            System.out.println("\n--- Juego terminado ---");
        }
    }
}
