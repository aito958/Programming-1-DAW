package ejercicio07;

import java.io.File;
import java.io.FileInputStream;
import java.io.IOException;
import java.io.ObjectInputStream;

public class Ejercicio07 {

	public static void main(String[] args) {

		File f = new File("src/ejercicio07/stock.dat");
		// crear flujos , leer objetos , mostrar todos los objetos del archivo
		
		try (FileInputStream fis = new FileInputStream(f);
		     ObjectInputStream ois = new ObjectInputStream(fis)) {
			
			Stock stock;
			System.out.println("=== Objetos Stock del archivo ===");
			try {
				while (true) {
					stock = (Stock) ois.readObject();
					System.out.println(stock);
				}
			} catch (java.io.EOFException e) {
				// Fin del archivo alcanzado
				System.out.println("=== Fin de lectura ===");
			}
			
		} catch (IOException e) {
			System.err.println("Error al leer el archivo: " + e.getMessage());
		} catch (ClassNotFoundException e) {
			System.err.println("Error al deserializar el objeto: " + e.getMessage());
		}
	}

}
