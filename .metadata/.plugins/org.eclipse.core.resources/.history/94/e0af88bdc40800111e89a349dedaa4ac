import java.util.Random;
import java.util.Scanner;

public class Jugador {
    private Flecha flechas;
    private boolean gameOverFlag;
    
    public Jugador() {
        this.flechas = new Flecha(1);
        this.gameOverFlag = false;
    }
    
    public int getFlechas() {
        return flechas.getCantidad();
    }
    
    public void elegir(int opcion, int valor) {
        try {
            switch(opcion) {
                case 1:
                    flechas.sumar(valor);
                    System.out.println(" +1 flecha -> Total: " + getFlechas());
                    break;
                case 2:
                    flechas.restar(valor);
                    System.out.println(" -1 flecha ->Total: " + getFlechas());
                    
                    break;
                case 3:
                    flechas.multiplicar(valor);
                    System.out.println(" ×" + valor + " -> Total: " + getFlechas());
                    break;
                case 4:
                    flechas.dividir(valor);
                    System.out.println(" ÷" + valor + " -> Total: " + getFlechas());
                    break;
                default:
                    System.out.println(" Opción inválida (1-4)");
            }
        } catch (FlechasInsuficientesException e) {
            System.out.println("error " + e.getMessage());
            gameOverFlag = true;
        } catch (IllegalArgumentException e) {
            System.out.println("error " + e.getMessage());
        }
    }
    
    public boolean gameOver() {
        return gameOverFlag;
    }
    
    public static void main(String[] args) {
        Jugador player = new Jugador();
        Scanner sc = new Scanner(System.in);
        Random rand = new Random();
        
        try {
            System.out.println( "ARROW MERGE RUN - EXAMEN POO ");
            System.out.println("Empiezas con 1 flecha. ¡Maximiza al final!");
            
            for (int nivel = 1; nivel <= 10; nivel++) {
                System.out.println("=== NIVEL " + nivel + " ===");
                System.out.println("Flechas actuales: " + player.getFlechas());
                
                int multiplicador = 2 + rand.nextInt(2);
                System.out.print("Elige: 1=+1, 2=-1, 3=x" + multiplicador + 
                                ", 4=/" + multiplicador + " → ");
                
                int opcion = sc.nextInt();
                int valor = (opcion == 3 || opcion == 4) ? multiplicador : 1;
                
                player.elegir(opcion, valor);
                
                if (player.gameOver()) {
                    System.out.println(" GAME OVER en nivel " + nivel);
                    break;
                }
            }
            
            if (!player.gameOver()) {
                System.out.println(" ¡VICTORIA! Final: " + player.getFlechas() + " flechas");
            }
            
        } catch (Exception e) {
            System.out.println(" Error: " + e.getMessage());
        } finally {
            sc.close();
            System.out.println("--- Juego terminado ---");
        }
    }
}