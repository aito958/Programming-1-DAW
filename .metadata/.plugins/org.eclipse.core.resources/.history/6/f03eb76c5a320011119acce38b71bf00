package juego;

import java.util.Random;
import java.util.Scanner;

import bloque.Bloque;
import bloque.categoria.BloqueMineral;
import bloque.categoria.BloqueTierra;
import bloque.categoria.BloqueVegetal;
import bloque.material.*;

public class Juego {

	public static final int TAMANO_MUNDO = 10;

	public static void main(String[] args) {
		Bloque[][][] mundo3D = generarMundo();
		Jugador yo = new Jugador("Jorge");

		colocarJugadorInicial(yo, mundo3D);

		Scanner sc = new Scanner(System.in);
		boolean salir = false;

		while (!salir) {
			System.out.println("\n===== MENÚ PRINCIPAL =====");
			System.out.println("1. Mover");
			System.out.println("2. Crear herramientas");
			System.out.println("3. Estado");
			System.out.println("4. [Especial] Radar de proximidad");
			System.out.println("0. Salir");
			System.out.print("Elige una opción: ");
			
			String opcion = sc.nextLine();

			switch (opcion) {
				case "1":
					gestionarMovimiento(yo, mundo3D, sc);
					break;
				case "2":
					yo.fabricarHerramientas();
					break;
				case "3":
					System.out.println(yo);
					break;
				case "4":
					usarRadar(yo, mundo3D);
					break;
				case "99":
					mostrarMapaSecreto(mundo3D);
					break;
				case "0":
					salir = true;
					System.out.println("Saliendo del juego...");
					break;
				default:
					System.out.println("Opción no válida.");
			}

			if (yo.haGanado()) {
				System.out.println("\n¡ENHORABUENA! Has recolectado 7 materias de cada tipo. ¡HAS GANADO!");
				System.out.println(yo);
				salir = true;
			}
		}
		sc.close();
	}

	/**
	 * Genera el mundo cumpliendo:
	 * - Suelo (z=0, z=1) sin bloques vacíos.
	 * - Resto del mundo con alta probabilidad de bloques vacíos para asegurar > 50% en total.
	 */
	public static Bloque[][][] generarMundo() {
		Bloque[][][] mundo = new Bloque[TAMANO_MUNDO][TAMANO_MUNDO][TAMANO_MUNDO];
		Random rd = new Random();

		for (int z = 0; z < TAMANO_MUNDO; z++) {
			for (int x = 0; x < TAMANO_MUNDO; x++) {
				for (int y = 0; y < TAMANO_MUNDO; y++) {
					if (z < 2) {
						// Suelo: Nunca vacío (forzamos un tipo de materia válido, del 0 al 5)
						int tipo = rd.nextInt(Bloque.NUM_MATERIAS);
						mundo[x][y][z] = instanciarBloque(tipo, x, y, z);
					} else {
						// Para asegurar que al menos la mitad (500) sean vacíos, damos un 65% de
						// probabilidad de ser vacío a las capas superiores (z de 2 a 9).
						if (rd.nextDouble() < 0.65) {
							mundo[x][y][z] = new BloqueVacio(x, y, z);
						} else {
							int tipo = rd.nextInt(Bloque.NUM_MATERIAS);
							mundo[x][y][z] = instanciarBloque(tipo, x, y, z);
						}
					}
				}
			}
		}
		return mundo;
	}

	private static Bloque instanciarBloque(int tipo, int x, int y, int z) {
		switch (tipo) {
			case Bloque.ALBERO: return new BloqueAlbero(x, y, z);
			case Bloque.ARBOL: return new BloqueArbol(x, y, z);
			case Bloque.ARCILLA: return new BloqueArcilla(x, y, z);
			case Bloque.COBRE: return new BloqueCobre(x, y, z);
			case Bloque.HIERRO: return new BloqueHierro(x, y, z);
			case Bloque.PLANTA: return new BloquePlanta(x, y, z);
			default: return new BloqueVacio(x, y, z);
		}
	}

	/**
	 * Coloca al jugador en la primera posición vacía (menor x, y, z posible).
	 */
	public static void colocarJugadorInicial(Jugador jugador, Bloque[][][] mundo) {
		for (int z = 0; z < TAMANO_MUNDO; z++) {
			for (int y = 0; y < TAMANO_MUNDO; y++) {
				for (int x = 0; x < TAMANO_MUNDO; x++) {
					if (mundo[x][y][z] instanceof BloqueVacio) {
						jugador.setPosicion(x, y, z);
						System.out.println("Jugador " + jugador.nombre + " posicionado inicialmente en: (X:" + x + ", Y:" + y + ", Z:" + z + ")");
						return; // Terminamos en cuanto encontramos el primero
					}
				}
			}
		}
	}

	/**
	 * Gestiona el movimiento y la destrucción de bloques con desgaste de herramientas.
	 */
	public static void gestionarMovimiento(Jugador j, Bloque[][][] mundo, Scanner sc) {
		System.out.println("¿Hacia dónde te mueves? (W: Arriba[+z], S: Abajo[-z], A: Izq[-x], D: Der[+x], Q: Adelante[+y], E: Atrás[-y])");
		String dir = sc.nextLine().toUpperCase();

		int nextX = j.x, nextY = j.y, nextZ = j.z;

		switch (dir) {
			case "D": nextX++; break;
			case "A": nextX--; break;
			case "Q": nextY++; break;
			case "E": nextY--; break;
			case "W": nextZ++; break;
			case "S": nextZ--; break;
			default:
				System.out.println("Dirección no válida. Cancelando movimiento.");
				return;
		}

		// Efecto Toroidal (Pac-Man)
		nextX = (nextX + TAMANO_MUNDO) % TAMANO_MUNDO;
		nextY = (nextY + TAMANO_MUNDO) % TAMANO_MUNDO;
		nextZ = (nextZ + TAMANO_MUNDO) % TAMANO_MUNDO;

		Bloque bloqueDestino = mundo[nextX][nextY][nextZ];

		if (bloqueDestino instanceof BloqueVacio) {
			j.setPosicion(nextX, nextY, nextZ);
			System.out.println("Te has movido a una casilla vacía: (" + nextX + "," + nextY + "," + nextZ + ")");
		} else {
			System.out.println("¡Hay un bloque interponiéndose! ¿Con qué intentas destruirlo?");
			System.out.println("1. Pico | 2. Pala | 3. Hacha");
			String opcion = sc.nextLine();
			String herramientaSeleccionada = "";

			if (opcion.equals("1")) herramientaSeleccionada = BloqueMineral.HERRAMIENTA;
			else if (opcion.equals("2")) herramientaSeleccionada = BloqueTierra.HERRAMIENTA;
			else if (opcion.equals("3")) herramientaSeleccionada = BloqueVegetal.HERRAMIENTA;
			else {
				System.out.println("Herramienta no válida. Cancelando movimiento.");
				return;
			}

			int usosRestantes = j.herramientas.get(herramientaSeleccionada);

			if (usosRestantes > 0) {
				// Determinamos qué herramienta era la correcta realmente
				String herramientaCorrecta = "";
				if (bloqueDestino instanceof BloqueMineral) herramientaCorrecta = BloqueMineral.HERRAMIENTA;
				else if (bloqueDestino instanceof BloqueTierra) herramientaCorrecta = BloqueTierra.HERRAMIENTA;
				else if (bloqueDestino instanceof BloqueVegetal) herramientaCorrecta = BloqueVegetal.HERRAMIENTA;

				// Gastamos 1 uso de la herramienta elegida
				j.herramientas.put(herramientaSeleccionada, usosRestantes - 1);

				if (herramientaSeleccionada.equals(herramientaCorrecta)) {
					// Destrucción exitosa con recolecta
					bloqueDestino.destruir(herramientaSeleccionada, j);
					System.out.println("¡Bloque destruido CORRECTAMENTE! Has recolectado la materia.");
				} else {
					// Destrucción sin recolecta por usar herramienta incorrecta
					System.out.println("Herramienta incorrecta... El bloque se destruye pero NO obtienes materiales.");
				}
				
				// Reemplazamos el bloque por uno vacío y movemos al jugador
				mundo[nextX][nextY][nextZ] = new BloqueVacio(nextX, nextY, nextZ);
				j.setPosicion(nextX, nextY, nextZ);
				System.out.println("Te has movido a la casilla: (" + nextX + "," + nextY + "," + nextZ + ")");
				System.out.println("Tu " + herramientaSeleccionada + " tiene ahora " + (usosRestantes - 1) + " usos.");

			} else {
				System.out.println("¡Tu " + herramientaSeleccionada + " está rota! (0 usos). Debes repararla.");
				System.out.println("No te has podido mover.");
			}
		}
	}

	/**
	 * Funcionalidad inventada y documentada: Radar de Proximidad.
	 * Analiza un área de 3x3x3 alrededor del jugador para contar cuántos recursos hay cerca,
	 * ayudando al jugador a decidir hacia dónde picar. Consume 1 uso de cualquier herramienta al azar.
	 */
	public static void usarRadar(Jugador j, Bloque[][][] mundo) {
		System.out.println("\n[📡 Activando Radar de Proximidad...]");
		int bloquesUtiles = 0;
		
		for (int z = -1; z <= 1; z++) {
			for (int y = -1; y <= 1; y++) {
				for (int x = -1; x <= 1; x++) {
					// Comprobar límites toroidales
					int checkX = (j.x + x + TAMANO_MUNDO) % TAMANO_MUNDO;
					int checkY = (j.y + y + TAMANO_MUNDO) % TAMANO_MUNDO;
					int checkZ = (j.z + z + TAMANO_MUNDO) % TAMANO_MUNDO;
					
					if (!(mundo[checkX][checkY][checkZ] instanceof BloqueVacio)) {
						bloquesUtiles++;
					}
				}
			}
		}
		System.out.println("El radar indica que hay " + bloquesUtiles + " bloques sólidos en tu entorno inmediato (3x3).");
	}

	/**
	 * Opción secreta: Muestra la cantidad total de bloques en el mundo por categoría.
	 */
	public static void mostrarMapaSecreto(Bloque[][][] mundo) {
		int vacios = 0, minerales = 0, tierras = 0, vegetales = 0;

		for (int z = 0; z < TAMANO_MUNDO; z++) {
			for (int y = 0; y < TAMANO_MUNDO; y++) {
				for (int x = 0; x < TAMANO_MUNDO; x++) {
					Bloque b = mundo[x][y][z];
					if (b instanceof BloqueVacio) vacios++;
					else if (b instanceof BloqueMineral) minerales++;
					else if (b instanceof BloqueTierra) tierras++;
					else if (b instanceof BloqueVegetal) vegetales++;
				}
			}
		}
		System.out.println("---  MAPA SECRETO (Estadísticas globales) ---");
		System.out.println("Bloques vacíos: " + vacios + " (" + ((vacios * 100) / 1000) + "%)");
		System.out.println("Bloques Minerales: " + minerales);
		System.out.println("Bloques de Tierra: " + tierras);
		System.out.println("Bloques Vegetales: " + vegetales);
		System.out.println("-------------------------------------------------");
	}
}