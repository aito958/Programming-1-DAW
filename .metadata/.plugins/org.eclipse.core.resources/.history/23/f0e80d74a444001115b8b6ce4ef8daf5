	public NetFlox() {
		mapPeliculas = new HashMap<String, PeliculasDeUnTema>();

	}

	public void annadirTema(String tema) throws NetFloxException {

		tema = tema.toUpperCase();
		if (mapPeliculas.containsKey(tema)) {
			throw new NetFloxException("Ya existe ese tema");
		}

		mapPeliculas.put(tema, new PeliculasDeUnTema(tema));
	}

	public void annadirPelicula(String tema, Pelicula pelicula) throws NetFloxException {
		PeliculasDeUnTema listaPeliculasDeUnTema = mapPeliculas.get(tema);

		if (listaPeliculasDeUnTema == null) {
			throw new NetFloxException("No existe el tema " + tema);
		}
		listaPeliculasDeUnTema.annadirPelicula(pelicula);
	}

