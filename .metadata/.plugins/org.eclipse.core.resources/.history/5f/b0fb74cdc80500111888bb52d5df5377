		if (longuitud > 0 && longuitud < 20) {
						
			
			this.longuitud = longuitud;
		} else {
			System.out.println("longuitud erronea");
		}
	}

	public int getAncho() {
		return ancho;
	}

	public void setAncho(int ancho) {
		if (longuitud > 0 && longuitud < 20) {
			this.ancho = ancho;
		}
	}

